{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pokedrafter",
  "compatibility_date": "2026-09-08",
  "main": "./src/index.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
"vars": {
  "GOOGLE_CLIENT_ID": "56169021326-uoudi0leg0suurj56c9sd5en3gvqr6si.apps.googleusercontent.com"
},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pokedrafter",
      "database_id": "d8f1077a-416f-4d61-ae01-b809b8e783b7"
    }
  ]
}
